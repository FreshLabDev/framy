# SPDX-License-Identifier: Apache-2.0
# framy local configuration. Copy to .env and fill in secrets. Never commit .env.
# A secret can also come from a file: set NAME_FILE to its path, as Docker
# secrets do. Setting both NAME and NAME_FILE is an error.

# The test bot's token from @BotFather, never the production one. Keep it in
# secrets/bot-token (gitignored): docker-compose.yml mounts that file, and a
# local `go run ./cmd/framy` reads it through this line.
TELEGRAM_BOT_TOKEN_FILE=secrets/bot-token

# The Bot API server. Production uses the family's telegram-bot-api in --local
# mode; locally the cloud one works for everything but files above 20 MB.
# TELEGRAM_API_BASE=https://api.telegram.org

# PostgreSQL. docker-compose.yml sets this for the bundled database, with a
# stand-in for core from deploy/core-init.sql. search_path is always set to
# framy by the service. DATABASE_URL_FILE works too.
DATABASE_URL=postgres://framy:framy@localhost:5432/framy?sslmode=disable

# Defaults: :8080, :9090, info, true. /metrics has its own listener so the
# tunnel that makes HTTP_ADDR public never exposes it; "off" turns it off.
# HTTP_ADDR=:8080
# METRICS_ADDR=:9090
# LOG_LEVEL=info
# AUTO_MIGRATE=true

# The addresses cloudflared connects from, as a comma-separated list of
# addresses and CIDR ranges: the Docker network the tunnel shares with framy.
# The rate limits count visitors by CF-Connecting-IP, and the header is
# believed only from these addresses. Empty, every visitor shares the bucket
# of cloudflared's address. Never 0.0.0.0/0, and never publish HTTP_ADDR's
# port to the host in production.
# TRUSTED_PROXIES=172.20.0.0/16

# The model catalog is read from OpenRouter's public API every hour; no key is
# needed. "off" stops the sync, for work without the network.
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# CATALOG_SYNC_INTERVAL=1h

# framy's own OpenRouter key pays for the free allowance; without it free runs
# fail before anything is paid. Prefer the file form in production.
# OPENROUTER_API_KEY_FILE=/run/secrets/openrouter-key

# Currency rates for prices in the person's currency: the NBU daily, with
# currency-api behind it. "off" stops the sync, for work without the network.
# FX_SYNC=on

# A stop waits this long for generations in progress before it cuts them
# short, which can cost the person a paid run. Keep the container's
# stop_grace_period above it.
# JOBS_STOP_GRACE=3m30s

# Cloudflare R2 keeps every input and result (docs/design.md, Storage and
# retention). The token is limited to framy's buckets; both halves can come
# from files. Without it the service starts, but no job can keep a result.
# The bucket is reached by the Cloudflare account id, or by R2_ENDPOINT, the
# full https://<account>.r2.cloudflarestorage.com, instead.
# R2_ACCOUNT_ID=
# R2_BUCKET=framy
# A test bot sharing the bucket writes under its own prefix, never u/:
# R2_PREFIX=test/
# R2_ACCESS_KEY_ID_FILE=/run/secrets/r2-access-key-id
# R2_SECRET_ACCESS_KEY_FILE=/run/secrets/r2-secret-access-key

# Working files of uploads and results, deleted when their work is done.
# ffmpeg 8.0 or newer normalizes photos; the image ships it.
# WORK_DIR=/tmp/framy
# FFMPEG=ffmpeg
# FFPROBE=ffprobe

# The chat's loops and cards, drawn once and kept between restarts. Not under
# WORK_DIR, which is swept every hour. Without libx264 in ffmpeg, /img stays
# off and the log says why.
# ANIM_CACHE_DIR=/tmp/framy-anim

# The chat that hears when the bucket passes another 10 GB.
# OPERATOR_CHAT_ID=

# The most the free tier may cost framy in a UTC day; when it is spent the
# tier closes until 00:00 UTC. 0 closes it. Set a daily limit on framy's
# OpenRouter key too, as the second fuse; framy reads it every minute.
# FREE_DAILY_BUDGET_USD=1

# The key-encryption key (KEK) for the keys people paste into the settings.
# A file, never a variable: docker inspect shows variables. One line per
# version, <version>:<base64 of 32 random bytes>; the highest wraps new keys.
# Make one with
#   printf '1:%s\n' "$(head -c 32 /dev/urandom | base64)" > secrets/kek && chmod 400 secrets/kek
# To rotate, add a line with the next version and restart: the service
# rewraps the stored keys and logs it, then the old line can go. Keep the
# file apart from the database backups; losing it loses every stored key.
# Without it nobody can connect a key of their own.
# FRAMY_KEK_FILE=secrets/kek

# The site's public origin: https, no path (http only for localhost, which
# Chrome and Firefox accept for work on a laptop). The redirect URI of
# sign-in (SITE_URL/auth/callback) and the OAuth callback given to OpenRouter
# (SITE_URL/oauth/openrouter/callback) are built from it, and OpenRouter names
# the app by its host. Without it sign-in on the site and "Connect
# OpenRouter" are off; the connect needs FRAMY_KEK_FILE too.
# SITE_URL=https://framy.ws04.cc

# Sign-in on the site (docs/design.md, Accounts) is Telegram Login: an OpenID
# Connect client that BotFather issues (Login Widget, with the site's origin
# and the redirect URI SITE_URL/auth/callback among its allowed URLs).
# Without the client /auth/login answers 503 and the rest runs; the Mini
# App's sign-in needs only the bot token. The secret can be a file.
# TELEGRAM_LOGIN_CLIENT_ID=
# TELEGRAM_LOGIN_CLIENT_SECRET_FILE=/run/secrets/telegram-login-secret

# Webhooks from OpenRouter (docs/design.md, Jobs). A video request carries a
# callback_url on SITE_URL, which has to be https for it, with a path nobody
# can guess: an HMAC of the job's id under HOOK_PATH_SECRET (at least 32
# characters; make one with
# `head -c 32 /dev/urandom | base64 > secrets/hook-path-secret`). The webhook
# only brings the next poll forward; the 30 s poll finishes a video without
# it, so leaving both out loses nothing but up to 30 seconds.
# OPENROUTER_WEBHOOK_SECRET is the signing secret set in the settings of the
# OpenRouter workspace that framy's own key belongs to; it checks the
# signature on the free runs' webhooks. A person's key belongs to their own
# workspace, so theirs are not checked. Cloudflare's Bot Fight Mode must be
# off for the hostname, or OpenRouter's POSTs get challenged.
# HOOK_PATH_SECRET_FILE=/run/secrets/hook-path-secret
# OPENROUTER_WEBHOOK_SECRET_FILE=/run/secrets/openrouter-webhook-secret
