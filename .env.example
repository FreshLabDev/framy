# SPDX-License-Identifier: Apache-2.0
# framy local configuration. Copy to .env and fill in secrets. Never commit .env.
# A secret can also come from a file: set NAME_FILE to its path, as Docker
# secrets do. Setting both NAME and NAME_FILE is an error.

# The test bot's token from @BotFather, never the production one. Keep it in
# secrets/bot-token (gitignored): docker-compose.yml mounts that file, and a
# local `go run ./cmd/framy` reads it through this line.
TELEGRAM_BOT_TOKEN_FILE=secrets/bot-token

# The Bot API server. Production uses the family's telegram-bot-api in --local
# mode; locally the cloud one works for everything but files above 20 MB.
# TELEGRAM_API_BASE=https://api.telegram.org

# PostgreSQL. docker-compose.yml sets this for the bundled database, with a
# stand-in for core from deploy/core-init.sql. search_path is always set to
# framy by the service. DATABASE_URL_FILE works too.
DATABASE_URL=postgres://framy:framy@localhost:5432/framy?sslmode=disable

# Defaults: :8080, :9090, info, true. /metrics has its own listener so the
# tunnel that makes HTTP_ADDR public never exposes it; "off" turns it off.
# HTTP_ADDR=:8080
# METRICS_ADDR=:9090
# LOG_LEVEL=info
# AUTO_MIGRATE=true

# The model catalog is read from OpenRouter's public API every hour; no key is
# needed. "off" stops the sync, for work without the network.
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# CATALOG_SYNC_INTERVAL=1h

# framy's own OpenRouter key pays for the free allowance; without it free runs
# fail before anything is paid. Prefer the file form in production.
# OPENROUTER_API_KEY_FILE=/run/secrets/openrouter-key

# A stop waits this long for generations in progress before it cuts them
# short, which can cost the person a paid run. Keep the container's
# stop_grace_period above it.
# JOBS_STOP_GRACE=3m30s

# Cloudflare R2 keeps every input and result (docs/design.md, Storage and
# retention). The token is limited to framy's buckets; both halves can come
# from files. Without it the service starts, but no job can keep a result.
# The bucket is reached by the Cloudflare account id, or by R2_ENDPOINT, the
# full https://<account>.r2.cloudflarestorage.com, instead.
# R2_ACCOUNT_ID=
# R2_BUCKET=framy
# R2_ACCESS_KEY_ID_FILE=/run/secrets/r2-access-key-id
# R2_SECRET_ACCESS_KEY_FILE=/run/secrets/r2-secret-access-key

# Working files of uploads and results, deleted when their work is done.
# ffmpeg 8.0 or newer normalizes photos; the image ships it.
# WORK_DIR=/tmp/framy
# FFMPEG=ffmpeg
# FFPROBE=ffprobe

# The chat that hears when the bucket passes another 10 GB.
# OPERATOR_CHAT_ID=
